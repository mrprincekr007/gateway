# =========================================================
# FatherGateway — Environment Configuration (.env)
# Copy this file to .env and customize values for your server
# =========================================================

# Application
APP_ENV=local
APP_KEY=CHANGE_ME_to_a_long_random_secret_string_1234567890
SITE_NAME="Father Gateway"
SITE_TAGLINE="UPI Payment Gateway & Webhooks"
SITE_EMAIL="support@fathergateway.in"
SUPPORT_WHATSAPP="910000000000"
CURRENCY_SYMBOL="₹"

# Prefixes
ORDER_PREFIX="fg_"
LINK_PREFIX="lnk_"
KEY_PREFIX="pk_"

# Database Connection (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fathergateway
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4
